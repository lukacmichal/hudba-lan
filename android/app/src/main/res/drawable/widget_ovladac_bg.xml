<?xml version="1.0" encoding="utf-8"?>
<!--
  Pozadie widgetu. Farba prehravaca (`metal_surface`) s okrajom `metal_border`,
  nie neutralna seda: widget ma na ploche vyzerat ako sucast tejto appky.
  Tie iste hodnoty ma windowsovy prehravac aj androidova tema.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/metal_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/metal_border" />
    <corners android:radius="18dp" />
</shape>
