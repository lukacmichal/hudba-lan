<?xml version="1.0" encoding="utf-8"?>
<!--
  Pas hlasitosti vo widgete: tmava draha a jantarova vypln — tie iste farby
  ako posuvnik v appke a prehravac na PC.

  Vypln je `scale`, nie `clip`: clip by oblemu koncu odrezal zaoblenie
  a vypln by koncila rovno odseknuta.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/metal_border" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale
            android:scaleGravity="left"
            android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <solid android:color="@color/metal_accent" />
            </shape>
        </scale>
    </item>
</layer-list>
