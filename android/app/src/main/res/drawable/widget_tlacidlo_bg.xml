<?xml version="1.0" encoding="utf-8"?>
<!--
  Pozadie tlacidla vo widgete. Konkretny drawable, nie
  `?android:attr/selectableItemBackground`: atribut temy sa v procese
  launchera nema podla coho rozlozit a widget sa potom neda ani pridat.

  Stlacene je jantarove, nie biele — rovnaka farba, akou svieti prehravac.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33D4860A" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
